[Unit]
Description=AnomalySpike Feature Extraction and Hybrid Detection
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=taki
WorkingDirectory=/home/taki/AnomalySpike
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc 'cd /home/taki/AnomalySpike && .venv/bin/python -m backend.app.services.features && .venv/bin/python -m backend.app.detection.engine'
